# Salin menjadi .streamlit/secrets.toml (lokal) atau tempel di Streamlit Cloud → App → Settings → Secrets.
# Jangan commit secrets.toml.

# Super user pertama, dibuat otomatis hanya bila tabel users masih kosong.
INITIAL_SUPERUSER_USERNAME = "renxy"
INITIAL_SUPERUSER_PASSWORD = "ganti-dengan-password-min-8-karakter"

# Wajib di Streamlit Community Cloud: database Postgres permanen (Supabase gratis, lihat DEPLOY_GRATIS.md)
# supaya user, sesi login, dan riwayat analisa tidak hilang saat restart/redeploy.
# Kosongkan hanya saat lokal (memakai SQLite data/app.db).
# Pakai URI Session pooler (port 5432), bukan Direct connection.
# DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
